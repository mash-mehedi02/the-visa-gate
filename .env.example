# ==============================================================================
# THE VISA GATE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL - Direct or Connection Pooling e.g., Supabase / Neon / Local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/the_visa_gate?schema=public

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-minimum-32-characters-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super-secret-refresh-key-minimum-32-characters-change-in-production
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=secure-cookie-secret-change-in-production
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 32 bytes hex for AES-256-GCM

# Storage Provider (local | s3 | supabase)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/documents
# S3 / Supabase Storage Configuration (if STORAGE_PROVIDER != local)
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=visa-gate-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Initial Admin Bootstrap (Used during initial migration/seed)
INITIAL_ADMIN_EMAIL=admin@thevisagate.com
INITIAL_ADMIN_PASSWORD=AdminSecureGate2026!
INITIAL_ADMIN_NAME="System Administrator"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX=10 # Max login attempts per window

# Cloudinary (optional — for private document and photo storage)
# Set all three to enable Cloudinary; leave blank to use local disk fallback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=thevisagate/documents
