# ==============================================================================
# THE VISA GATE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL - Direct or Connection Pooling e.g., Supabase / Neon / Local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/the_visa_gate?schema=public

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-minimum-32-characters-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super-secret-refresh-key-minimum-32-characters-change-in-production
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=secure-cookie-secret-change-in-production
ENCRYPTION_KEY=REPLACE-WITH-64-HEX-CHARACTERS # 32 bytes hex for AES-256-GCM (generate with: openssl rand -hex 32)

# Storage Provider (local | s3 | supabase)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/documents

# Outbound email (REQUIRED for staff sign-in MFA codes and client password reset).
# Without working SMTP, staff cannot complete MFA sign-in and reset tokens
# cannot be delivered. There is no in-app fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=The Visa Gate <no-reply@thevisagate.com>
# S3 / Supabase Storage Configuration (if STORAGE_PROVIDER != local)
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=visa-gate-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Initial Admin Bootstrap (Used during initial migration/seed)
INITIAL_ADMIN_EMAIL=admin@thevisagate.com
INITIAL_ADMIN_PASSWORD=REPLACE-WITH-A-STRONG-PASSWORD
INITIAL_ADMIN_NAME="System Administrator"

# Sample / demo accounts created by `prisma/seed.ts` (no default passwords exist)
SEED_STAFF_PASSWORD=REPLACE-WITH-A-STRONG-PASSWORD
SEED_CLIENT_PASSWORD=REPLACE-WITH-A-STRONG-PASSWORD

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX=10 # Max login attempts per window
