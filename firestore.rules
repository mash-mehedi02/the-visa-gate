//     && resource.data.clientId == ownClientId());
//   allow create, update, delete: if isStaff();
// }
// match /documents/{documentId} {
//   // Document metadata only — file bytes never live in Firestore.
//   // Clients may read their own documents' metadata; they must never
//   // write document records directly (uploads go through the API,
//   // which stores the Cloudinary public_id / secure_url).
//   allow read: if isStaff() || (isSignedIn() && role() == 'CLIENT'
//     && resource.data.clientId == ownClientId());
//   allow create, update, delete: if isStaff();
// }
// match /inquiries/{inquiryId} {
//   allow read: if isStaff();
//   allow create: if true; // public contact form; server-validated
//   allow update, delete: if isAdmin();
// }
// match /audit_logs/{logId} {
//   allow read: if isAdmin();
//   allow create, update, delete: if false; // server (Admin SDK) only
// }
//
// Known limits of rules alone (enforced in the API instead):
//   * Rules cannot check that a document upload is an image, virus-free
//     or under a size limit — the API validates type/size and scans
//     before storing (see DocumentService.scanFileSecurity).
//   * Rules cannot enforce "client may only set their own profile pic"
//     beyond matching clientId — the API checks ownership on every call.
//   * Rules cannot hide individual fields: a client who can read a
//     document can read every field in it, so the API strips internal
//     staff notes and local storage paths before mirroring
//     (see FirebaseDatabaseService.syncDocument).
// -----------------------------------------------------------------
